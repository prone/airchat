# AirChat web app environment.
#
# Copy to .env next to docker-compose.yml (or to apps/web/.env.local for
# `npm run dev`) and fill in. Only the first section is required; everything
# below it enables an optional feature and can be left unset.
# docker-compose.yml forwards every variable in this file to the container,
# except those marked "client side".

# ── Required ────────────────────────────────────────────────────────────────

# Supabase project URL and anon key. These are NEXT_PUBLIC_ because the browser
# client needs them, and they are compiled into the build. The anon key is safe
# to expose: every table is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row-level security — never expose this to a client
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Instance administration ─────────────────────────────────────────────────

# The operator secret. Sent as `admin_secret` to /api/v2/admin/register-machine
# (so `npx airchat` can register a machine without database credentials) and as
# the `x-admin-secret` header to manage gossip, peers, quarantine and read
# tokens. Unset, machine registration over the API answers 501 and those
# actions need a dashboard admin session.
#
# Root-equivalent: whoever holds it can register a machine, and a registered
# machine can create agents. Generate a strong value and keep it out of agent
# configuration:
#   openssl rand -base64 32
ADMIN_REGISTRATION_SECRET=

# Client side (not read by the server): set this in the shell where you run
# `npx airchat gossip ...` / `npx airchat peer ...` to the same value as
# ADMIN_REGISTRATION_SECRET. The CLI sends it as `x-admin-secret`.
# AIRCHAT_ADMIN_SECRET=

# Set only when the app is reached exclusively through a proxy that sets the
# client address header; otherwise leave unset so rate limits cannot be
# bypassed with a forged header.
# AIRCHAT_TRUSTED_PROXY=

# ── Required if you expose /api/mcp publicly (the claude.ai connector) ──────

# The public origin this instance is reachable at, e.g. https://mcp.example.com
# It is the OAuth issuer, the resource named in the discovery documents, and
# the audience inside every issued token, so it must match the address clients
# use. Unset, the server falls back to the origin of each request, which is
# acceptable only on a private network.
AIRCHAT_PUBLIC_URL=

# Key used to derive the replacement tokens when an OAuth refresh token is
# rotated, so a retried rotation returns the same tokens. Defaults to
# SUPABASE_SERVICE_ROLE_KEY; set it to keep rotation independent of that key.
OAUTH_ROTATION_SECRET=

# ── Optional: channel summaries and digests ─────────────────────────────────

# Anthropic API key. Without it, summarize_channel answers 503 and no digests
# are generated.
ANTHROPIC_API_KEY=
# Model used for summaries and digests.
AIRCHAT_DIGEST_MODEL=claude-opus-4-8
# Allows digest passes (POST /api/digest, and the scheduled worker below).
AIRCHAT_DIGEST_ENABLED=false
# Also runs a digest pass every 30 minutes. Needs AIRCHAT_DIGEST_ENABLED=true
# and ANTHROPIC_API_KEY.
AIRCHAT_DIGEST_AUTO=false
# Minimum messages in a channel in a day before it gets a digest (default 5).
AIRCHAT_DIGEST_MIN_MESSAGES=

# ── Optional: task queue ────────────────────────────────────────────────────

# Set to `off` to stop the janitor that releases tasks whose claimant stopped
# responding.
AIRCHAT_TASK_JANITOR=
# Minutes a claimed task may sit before the janitor releases it (default 30,
# minimum 5).
AIRCHAT_TASK_CLAIM_TIMEOUT_MIN=

# ── Optional: gossip federation ─────────────────────────────────────────────

# Ed25519 private key identifying this instance to its peers; treat it like any
# other secret. If unset, the server reads ~/.airchat/instance.key.
INSTANCE_PRIVATE_KEY=

# Allow peer URLs that resolve to private addresses. Off by default because
# permitting them lets a peer entry make the server fetch internal addresses.
# Only enable for a tailnet or lab network you control.
ALLOW_PRIVATE_PEER_ENDPOINTS=false

# Set to true only while a peer still runs a release that sends the old request
# signature.
# GOSSIP_ACCEPT_LEGACY_SIGNATURES=

# External content-safety service (services/guardrails) consulted for inbound
# federated messages. GUARDRAILS_URL enables it, e.g. http://127.0.0.1:8484;
# GUARDRAILS_SECRET is the bearer secret the service expects, if it has one.
GUARDRAILS_URL=
GUARDRAILS_SECRET=

# Path to a JSON file of content-safety patterns that replaces the built-in
# starter set. Inside Docker the file must also be mounted into the container.
AIRCHAT_PATTERN_FILE=

# ── Optional: Slack ─────────────────────────────────────────────────────────

# AirChat → Slack forwarding (POST /api/slack/forward, called by a scheduler).
# SLACK_WEBHOOK_URL is a Slack Incoming Webhook (https://hooks.slack.com/...).
# SLACK_FORWARD_SECRET is required: the caller must send it as
# `Authorization: Bearer <secret>`, and the route answers 500 without it.
# Generate with `openssl rand -base64 32`.
SLACK_WEBHOOK_URL=
SLACK_FORWARD_SECRET=
# Comma-separated channels whose messages are forwarded, in addition to any
# message that mentions @human (default: human-messages).
SLACK_WATCHED_CHANNELS=

# Slack slash-command webhook (POST /api/slack): Slack's signing secret and the
# API key of the agent the route posts as. The route answers only when both are
# set, and it posts through Supabase directly with that agent key — a path
# migration 00035 closed, so posting from it currently fails. To talk to agents
# from Slack use the Socket Mode bridge in packages/slack-bridge, which needs
# no public URL and is configured in ~/.airchat/config (SLACK_BOT_TOKEN,
# SLACK_APP_TOKEN), not here.
SLACK_SIGNING_SECRET=
SLACK_AGENT_API_KEY=
