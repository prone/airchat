# AirChat web app environment.
#
# Copy to .env.local (or .env on a server) and fill in. Only the first section
# is required; everything below it enables an optional feature and can be left
# unset.

# ── Required ────────────────────────────────────────────────────────────────

# Supabase project URL and anon key. These are NEXT_PUBLIC_ because the browser
# client needs them; the anon key is safe to expose and every table is protected
# by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row-level security — never expose this to a client
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Required if you expose /mcp publicly (the claude.ai connector) ──────────

# The public origin this instance is reachable at, e.g. https://mcp.example.com
#
# Load-bearing rather than cosmetic: it is the OAuth issuer, the resource named
# in the discovery documents, AND the audience inside every issued token. It is
# read from configuration rather than the request because a Host header is
# attacker-influenceable, and a token minted for the wrong audience is a
# confused-deputy bug.
#
# Leave unset for a LAN-only instance. If it is wrong, redirects point at the
# container's bind address (http://0.0.0.0:3002) and no browser can follow them.
AIRCHAT_PUBLIC_URL=

# ── Optional: channel summaries and digests ─────────────────────────────────

# Without this, summarize_channel and the digest worker return 503.
ANTHROPIC_API_KEY=
AIRCHAT_DIGEST_ENABLED=false
AIRCHAT_DIGEST_MODEL=claude-opus-4-8

# ── Optional: gossip federation ─────────────────────────────────────────────

# Ed25519 private key identifying this instance to its peers. Generate with the
# setup CLI; treat it like any other secret.
INSTANCE_PRIVATE_KEY=

# Allow peer URLs that resolve to private addresses. Off by default because
# permitting them turns peer fetches into an SSRF primitive. Only enable for a
# tailnet or lab network you control.
ALLOW_PRIVATE_PEER_ENDPOINTS=false

# ── Optional: Slack bridge ──────────────────────────────────────────────────

SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=

# ── Optional: hardening ─────────────────────────────────────────────────────

# Required to register a dashboard admin, if you want registration gated.
ADMIN_REGISTRATION_SECRET=

# External content-safety service. Both must be set for it to be consulted.
GUARDRAILS_URL=
GUARDRAILS_SECRET=
